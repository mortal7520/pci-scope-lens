{
  "manifest_version": 3,
  "name": "PCI Scope Lens",
  "version": "0.1.1",
  "description": "See whether card fields are isolated in a PCI provider iframe. Client-side only; no data leaves the browser.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "PCI Scope Lens",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "logic.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
